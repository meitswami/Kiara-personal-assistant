# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ERP Configuration (use VITE_ prefix for client-side access)
ERP_API_URL="https://your-portal.com/api"
ERP_API_KEY="your_api_key"
ERP_API_SECRET="your_api_secret"
ERP_AUTH_TOKEN="your_token"
VITE_ERP_API_URL="https://your-portal.com/api"
VITE_ERP_API_KEY="your_api_key"
VITE_ERP_API_SECRET="your_api_secret"
VITE_ERP_AUTH_TOKEN="your_token"

# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WhatsApp Integration (Twilio)
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"

# Gmail & Google Calendar Integration (Google OAuth2)
# Scopes include: gmail.readonly, gmail.send, gmail.modify, calendar, calendar.events
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/gmail/callback"

# Google Calendar Integration
GOOGLE_CALENDAR_ENABLED="true"
